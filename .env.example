# Shopify Admin API credentials, used to read back the order a run just placed.
#
# Without these the tool still places orders — it falls back to reading the order
# number off the confirmation page, and records source: "page" so a scraped number
# is never mistaken for the store's own answer.
#
# Copy to .env (which is gitignored) and fill in. The app authenticates per store
# with an OAuth client-credentials grant, so one pair covers every store the app
# is installed on.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The stores each environment points at. These defaults match the FiftyFlowers
# dev and stage stores, so they only need setting to point somewhere else.
SHOPIFY_DEV_SHOP=bloom-brain-dev
SHOPIFY_STAGING_SHOP=bloom-brain-stage
