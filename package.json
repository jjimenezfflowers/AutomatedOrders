{
  "name": "playwright-order",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/",
    "test:ui-smoke": "node tests/ui-smoke.js",
    "test:product-form": "playwright test tests/product-form-helpers.spec.js --project=chromium",
    "test:mini-calla": "playwright test tests/mini-calla-product-options.spec.js --project=chromium",
    "test:peach-sorbet": "ORDER_CONFIG=order-config-peach-sorbet.json playwright test tests/place-order.spec.js --project=chromium",
    "start": "node server.js",
    "test:integration": "node --test tests/integration/",
    "db:migrate": "DATABASE_URL=file:./db.sqlite prisma migrate deploy",
    "db:studio": "DATABASE_URL=file:./db.sqlite prisma studio",
    "db:generate": "DATABASE_URL=file:./db.sqlite prisma generate",
    "db:seed": "node prisma/seed-from-json.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/client": "^6.19.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
